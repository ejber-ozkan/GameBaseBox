{
  "amiga-retroarch-zip-multi-disk-m3u": {
    "args": [
      "-L",
      "<ROOT>/cores/puae_libretro.so",
      "<TMP>/Game Disk1.m3u"
    ],
    "emulator": "<ROOT>/emu/retroarch",
    "files": {
      "<TMP>/Game Disk1.m3u": "<TMP>/Game/Game Disk1.adf\n<TMP>/Game/Game Disk2.adf\n"
    }
  },
  "amiga-winuae-whdload": {
    "args": [
      "-G",
      "-s",
      "filesystem2=rw,DH1:DH1:<TMP>/Game/Game,0",
      "-s",
      "filesystem=rw,DH1:<TMP>/Game/Game"
    ],
    "emulator": "<ROOT>/emu/winuae.exe",
    "files": {}
  },
  "amiga-winuae-zip-sibling-disks": {
    "args": [
      "-G",
      "-0",
      "<TMP>/Game_Disk1/Game Disk1.adf",
      "-1",
      "<TMP>/Game_Disk2/Game Disk2.adf",
      "-diskswapper=<TMP>/Game_Disk1/Game Disk1.adf,<TMP>/Game_Disk2/Game Disk2.adf"
    ],
    "emulator": "<ROOT>/emu/winuae.exe",
    "files": {}
  },
  "amstradcpc-cpce-direct": {
    "args": [
      "-autostart",
      "<ROOT>/roms/Game.dsk"
