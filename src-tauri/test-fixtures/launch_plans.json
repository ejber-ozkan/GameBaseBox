    "emulator": "<ROOT>/emu/kegs",
    "files": {
      "<ROOT>/emu/config.kegs": "s5d1 = \ns5d2 = \ns6d1 = <TMP>/Game/Game Side A.dsk\ns6d2 = <TMP>/Game/Game Side B.dsk\ns7d1 = "
    }
