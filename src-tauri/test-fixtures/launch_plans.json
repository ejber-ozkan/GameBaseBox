  },
  "apple2gs-kegs-direct-2mg": {
    "args": [
      "-s5d1=<ROOT>/roms/Game.2mg",
      "-s5d2=",
      "-s6d1=",
      "-s6d2=",
      "-s7d1="
    ],
    "emulator": "<ROOT>/emu/kegs",
    "files": {
      "<ROOT>/emu/config.kegs": "s5d1 = <ROOT>/roms/Game.2mg\ns5d2 = \ns6d1 = \ns6d2 = \ns7d1 = "
    }
  },
  "apple2gs-kegs-zip-525": {
