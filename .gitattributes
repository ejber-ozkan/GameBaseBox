# Normalize line endings: LF in the repository; scripts keep the endings their shell needs.
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
/.editorconfig text eol=lf
/.gitattributes text eol=lf
*.toml text eol=lf

# Keep repository support data out of exported source archives.
.beads export-ignore
graphify-out export-ignore
.claude export-ignore
.codex export-ignore
.agents export-ignore
.agent export-ignore
plans export-ignore
AGENTS.override.md export-ignore
handover*.md export-ignore
